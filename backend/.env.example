# Perfil de ejecucion: local o mysql
SPRING_PROFILES_ACTIVE=mysql

# Conexion MySQL. No colocar credenciales reales en el repositorio.
DB_URL=jdbc:mysql://localhost:3306/asiscontrol?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
DB_USERNAME=asiscontrol_app
DB_PASSWORD=cambiar_en_entorno_local

# Al menos 32 caracteres. En produccion debe provenir de un gestor de secretos.
JWT_SECRET=reemplazar_por_un_secreto_seguro_de_32_caracteres
JWT_EXPIRATION_MINUTES=30

# Origenes del frontend separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Administrador inicial opcional. Solo se crea cuando las tres variables existen.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_DOCUMENT=00000000
BOOTSTRAP_ADMIN_EMAIL=admin@colegio.edu.pe
BOOTSTRAP_ADMIN_PASSWORD=cambiar_inmediatamente
BOOTSTRAP_ADMIN_USERNAME=admin

# Directorio local para archivos adjuntos.
FILE_STORAGE_PATH=./storage
